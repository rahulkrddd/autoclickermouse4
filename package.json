{
  "name": "autoclickermouse-mongodb",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "start": "node app.js",
    "check": "node --check app.js && find config models services routes scripts tests public/js -name '*.js' -print0 | xargs -0 -n1 node --check",
    "migrate:dry": "node scripts/migrate.js --dry-run",
    "migrate": "node scripts/migrate.js",
    "indexes": "node scripts/indexes.js",
    "validate:db": "node scripts/validate-db.js",
    "reconcile:customers": "node scripts/reconcile-customers.js",
    "storage:check": "node scripts/check-storage.js",
    "test": "node --test tests/*.test.js",
    "defaults:dry": "node scripts/backfill-product-defaults.js --dry-run",
    "defaults:backfill": "node scripts/backfill-product-defaults.js",
    "invoices:dry": "node scripts/backfill-invoices.js --dry-run",
    "invoices:backfill": "node scripts/backfill-invoices.js",
    "audit:products": "node scripts/audit-products.js",
    "validate:queries": "node scripts/validate-queries.js",
    "validate:products": "node scripts/validate-products.js",
    "site:migrate:dry": "node scripts/migrate-site-id.js --dry-run",
    "site:migrate": "node scripts/migrate-site-id.js --apply",
    "site:verify": "node scripts/validate-site-isolation.js",
    "site:indexes:dry": "node scripts/migrate-site-indexes.js --dry-run",
    "site:audit": "node scripts/audit-unscoped-queries.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "axios": "^1.12.2",
    "connect-mongo": "^5.1.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "mongoose": "^8.18.1",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "razorpay": "^2.9.6",
    "acorn": "^8.12.1"
  },
  "engines": {
    "node": ">=20"
  }
}